{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LarkquillAI",
  "version": "0.3.8",
  "identifier": "com.framefx.wyneai",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "LarkquillAI",
        "width": 1100,
        "height": 800,
        "minWidth": 720,
        "minHeight": 520,
        "backgroundColor": "#b8c5e6"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "FrameFX",
    "shortDescription": "LarkquillAI desktop agent",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI1QzY2Mjk3RDMzMzJEMUYKUldRZkxUUFRsMkxHdGNkM21wZjhuSFJHSGtlaVdORnJkbWh1YWtmNHZZM0xuVFFqVmQ5MEEreDEK",
      "endpoints": [
        "https://github.com/ilikemacos/wyneai-desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
