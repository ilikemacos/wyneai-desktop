{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WyneAI",
  "version": "0.1.0",
  "identifier": "com.framefx.wyneai",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "WyneAI", "width": 1100, "height": 800, "minWidth": 720, "minHeight": 520, "backgroundColor": "#111111" }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "FrameFX",
    "shortDescription": "WyneAI desktop agent",
    "category": "Productivity",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser" } },
    "macOS": { "minimumSystemVersion": "10.15" }
  }
}
